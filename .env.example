# Claude
CLAUDE_API_KEY=tu_clave_claude_aqui
# Modelo y profundidad de razonamiento (opcionales; estos son los defaults)
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_EFFORT=medium

# Notion
NOTION_TOKEN=tu_token_notion_aqui
NOTION_DATABASE_ID=2fe6046f0fee81bcb5fac1b261e6fcdf

# Telegram
TELEGRAM_BOT_TOKEN=tu_token_del_bot
# Secret token del webhook: se setea también en setWebhook. Sin esto, cualquiera
# con la URL puede inyectar updates falsos.
TELEGRAM_WEBHOOK_SECRET=una_cadena_larga_random
# IDs de Telegram autorizados, separados por coma. OBLIGATORIO: el bot falla
# CERRADO, o sea que si esto queda vacío no le contesta a nadie. (Antes era al
# revés y el bot quedó abierto en producción con escritura sobre Notion y Calendar.)
TELEGRAM_ALLOWED_USER_IDS=5029988668

# Cierre del día y plan de la mañana (Cloud Scheduler → /cron/*)
# Sin CRON_SECRET los endpoints de cron quedan cerrados. Es un secret propio y no
# el del webhook: son dos superficies distintas y se rotan por separado.
CRON_SECRET=otra_cadena_larga_random
# A qué chat le escribe el bot cuando arranca él la conversación. En un chat
# privado el chat_id es igual al user_id. Si se omite, usa el primero de la whitelist.
TELEGRAM_CHAT_ID=5029988668

# Google (OAuth personal de Lucas — Calendar + Drive)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=lucas@dlaurenzano.com

# Groq (transcripción de audios de Telegram con Whisper)
GROQ_API_KEY=

# Puerto
PORT=8080

# Entorno
NODE_ENV=production
